datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Documento {
  id              Int     @id @default(autoincrement())
  numeroSerie     String  @unique
  fechaEmision    DateTime
  tipoDocumento   String
  solicitud       String
  dni             String
  nombre          String
  fotoBlob        Bytes? // Prisma mapea esto a PostgreSQL BYTEA
}
